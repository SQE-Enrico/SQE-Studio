# Configure once on the laboratory server; do not commit the resulting studio.env.
SQE_HOST=sqe.example.org
SQE_MAX_JOBS=2
SQE_TOTAL_CPUS=8
SQE_MEMORY_GB=16
# Browser project-capsule and expanded archive limits (MiB).
SQE_MAX_CAPSULE_MB=512
SQE_MAX_EXPANDED_MB=8192
# Core image runs the analytical workflow immediately.
SQE_DOCKERFILE=deploy/Dockerfile
# Full optional image: deploy/Dockerfile.palace (build and qualify on your host).
